<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<!-- Servidor: LocalDB (la versión de SQL Server que viene con Visual Studio) -->
		<add name="PRAS"
			 connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=PRAS;Integrated Security=True;TrustServerCertificate=True"
			 providerName="Microsoft.Data.SqlClient" />

		<!-- Segunda base: SEGURIDAD (usuarios, dígitos verificadores y bitácora).
		     Es la que usa el proyecto PRAS.Services. -->
		<add name="PRAS_Seguridad"
			 connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=PRAS_Seguridad;Integrated Security=True;TrustServerCertificate=True"
			 providerName="Microsoft.Data.SqlClient" />
	</connectionStrings>
	<appSettings>
		<!-- Multi idioma: carpeta y nombre de los archivos (I18n\idioma.es-AR, I18n\idioma.en-US) -->
		<add key="I18NFolder" value="I18n"/>
		<add key="I18NFileName" value="idioma"/>

		<!-- Bitácora: dónde se graba. "Sql" = tabla Bitacora de PRAS_Seguridad; "File" = archivo de texto.
		     Si la base no responde, se graba igual en el archivo para no perder nada. -->
		<add key="LoggerType" value="Sql"/>
		<add key="FileName" value="Logs\bitacora.log"/>
		<add key="MinimalLogLevel" value="Info"/>

		<!-- Backup: carpeta que se propone para guardar los .bak -->
		<add key="BackupFolder" value="Backups"/>

		<!-- Datos del administrador del sistema: se muestran en "Recuperar contraseña" y en "Pedir ayuda". -->
		<add key="SoporteNombre" value="Matías Montoto"/>
		<add key="SoporteTelefono" value="11 6501-6694"/>
		<add key="SoporteEmail" value="matiasmontoto5@gmail.com"/>

		<!-- Datos de prueba (para mostrar el sistema). En una instalación real poner los dos en false.
		     CargarDatosDePrueba: al abrir el programa crea los usuarios de prueba que falten (uno por mecánico)
		                          y carga operaciones 2024-2026. Nunca cambia la contraseña de un usuario existente.
		     MostrarUsuariosDePrueba: muestra el link "Usuarios de prueba" en la pantalla de ingreso. -->
		<add key="CargarDatosDePrueba" value="true"/>
		<add key="MostrarUsuariosDePrueba" value="true"/>

		<!-- Encriptado simétrico AES-256: clave de 32 bytes en Base64.
		     Se usa para guardar encriptados el teléfono y el email de los clientes.
		     Si se cambia la clave, los datos encriptados con la anterior ya no se pueden leer. -->
		<add key="ClaveAES" value="6Z1Dbc82cEZisxdVa3heLysk2SRYJH0OYLvZqTlZDzI="/>
	</appSettings>
</configuration>